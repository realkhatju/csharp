{
  "info": {
    "_postman_id": "b7c1a3f2-5d4e-4c8a-9f1b-2e6d7a8c9b01",
    "name": "CrudApi",
    "description": "Full CRUD collection for the CrudApi products API (ASP.NET Core + EF Core SQLite).\n\nRun the API first:\n  dotnet run --project CrudApi --urls http://localhost:5040\n\nCollection variables:\n  - baseUrl: API base URL\n  - productId: set automatically by the Create request, used by Get/Update/Delete",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5040",
      "type": "string"
    },
    {
      "key": "productId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Products",
      "item": [
        {
          "name": "List Products",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response has pagination fields', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('items');",
                  "  pm.expect(body).to.have.property('page');",
                  "  pm.expect(body).to.have.property('pageSize');",
                  "  pm.expect(body).to.have.property('totalCount');",
                  "  pm.expect(body.items).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products?page=1&pageSize=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "10" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Search Products",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('All items match the search term', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.items.every(i =>",
                  "    (i.name || '').toLowerCase().includes('keyboard') ||",
                  "    (i.category || '').toLowerCase().includes('keyboard') ||",
                  "    (i.description || '').toLowerCase().includes('keyboard')",
                  "  )).to.be.true;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products?search=keyboard&category=Electronics&page=1&pageSize=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"],
              "query": [
                { "key": "search", "value": "keyboard" },
                { "key": "category", "value": "Electronics" },
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "10" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Product By Id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Returns the requested product', () => pm.expect(String(body.id)).to.eql(pm.collectionVariables.get('productId')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "{{productId}}"]
            }
          },
          "response": []
        },
        {
          "name": "Get Product By Id (Not Found)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products/999999",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "999999"]
            }
          },
          "response": []
        },
        {
          "name": "Create Product",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Response contains an id', () => pm.expect(body.id).to.be.a('number'));",
                  "pm.test('Echoes submitted values', () => {",
                  "  pm.expect(body.name).to.eql('Postman Widget');",
                  "  pm.expect(body.price).to.eql(49.99);",
                  "  pm.expect(body.stock).to.eql(10);",
                  "  pm.expect(body.category).to.eql('Testing');",
                  "});",
                  "pm.test('Location header points to the new product', () => {",
                  "  pm.expect(pm.response.headers.get('Location')).to.match(new RegExp('/api/products/' + body.id + '$', 'i'));",
                  "});",
                  "pm.collectionVariables.set('productId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Widget\",\n  \"description\": \"Created from the Postman collection\",\n  \"price\": 49.99,\n  \"stock\": 10,\n  \"category\": \"Testing\"\n}",
              "options": {
                "raw": { "language": "json" }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"]
            }
          },
          "response": []
        },
